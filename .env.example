APP_ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://pm:pm@localhost:5432/pm_alpha_bot

POLY_GAMMA_HOST=https://gamma-api.polymarket.com
POLY_DATA_HOST=https://data-api.polymarket.com
POLY_CLOB_HOST=https://clob-v2.polymarket.com
POLY_WS_MARKET_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Trading mode
ENABLE_LIVE_TRADING=false
PAPER_INITIAL_CAPITAL=1000
LIVE_INITIAL_CAPITAL=1000
PAPER_FILL_MIN_DWELL_SEC=30
PAPER_QUEUE_MISS_BPS=25
REPLAY_FILL_MIN_DWELL_SEC=30
REPLAY_QUEUE_MISS_BPS=25

# Optional live trading secrets
POLY_PRIVATE_KEY=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
POLY_ADDRESS=
POLY_FUNDER_ADDRESS=
POLY_SIGNATURE_TYPE=0
POLY_BUILDER_CODE=

# Strategy parameters
MIN_WALLET_CONSENSUS=3
MIN_EDGE_BPS=500
MAX_SPREAD_BPS=500
MAX_MARKET_EXPOSURE_PCT=0.03
MAX_CONDITION_EXPOSURE_PCT=0.03
MAX_EVENT_EXPOSURE_PCT=0.06
MAX_CATEGORY_EXPOSURE_PCT=0.15
MAX_DAILY_LOSS_PCT=0.02
MAX_TOTAL_DRAWDOWN_PCT=0.10
KELLY_FRACTION=0.25
SIGNAL_MIN_WALLET_SCORE=0.35
SIGNAL_ACTIVITY_LOOKBACK_HOURS=8
PM_ALPHA_MARKET_CATEGORY_FILTER=
OBSERVATION_PROMOTION_MIN_STREAK=3
OBSERVATION_QUEUE_REMINDER_EVERY_STREAK=3

# Data collection
LEADERBOARD_LIMIT=50
TRACKED_WALLET_LIMIT=100
WALLET_MARKET_LOOKBACK_HOURS=24
WALLET_MARKET_ENRICHMENT_LIMIT=100
PM_ALPHA_TRADEABLE_ORDERBOOK_FOCUS=false
PM_ALPHA_TRADEABLE_ORDERBOOK_FOCUS_WINDOW_MINUTES=360
MISSING_ORDERBOOK_CACHE_TTL_HOURS=6
ORDERBOOK_POLL_INTERVAL_SEC=15
LIVE_HEARTBEAT_INTERVAL_SEC=5
LIVE_ORDER_SYNC_LIMIT=50
LIVE_MAX_CONSECUTIVE_ERRORS=3
LIVE_CANCEL_ALL_ON_KILL_SWITCH=true
RUNTIME_EVENT_RETENTION_DAYS=30
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_SEC=10

# Optional console HTTP Basic Auth
PM_ALPHA_CONSOLE_AUTH_USERNAME=
PM_ALPHA_CONSOLE_AUTH_PASSWORD=
PM_ALPHA_CONSOLE_AUTH_REALM="PM Alpha Bot Console"
