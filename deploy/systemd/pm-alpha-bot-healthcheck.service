[Unit]
Description=PM Alpha Bot Live Healthcheck
After=pm-alpha-bot-live.service
Requires=pm-alpha-bot-live.service

[Service]
Type=oneshot
User=pm-bot
Group=pm-bot
WorkingDirectory=/opt/pm-alpha-bot
EnvironmentFile=/etc/pm-alpha-bot/live.env
ExecStart=/opt/pm-alpha-bot/.venv/bin/pm-bot ops healthcheck --require-live-supervisor --fail-on-kill-switch --fail-on-supervisor-error --max-supervisor-age-sec 30
